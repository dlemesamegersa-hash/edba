# Copy to .env and fill in from Firebase Console > Project settings > Your apps > Web app.
# These values are NOT secrets (they identify your project); access is controlled by Firebase rules/auth settings.
EXPO_PUBLIC_FIREBASE_API_KEY=REPLACE_ME
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_ME.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_ME
EXPO_PUBLIC_FIREBASE_APP_ID=REPLACE_ME
